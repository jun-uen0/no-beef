{
  "name": "no-beef",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that softens hostile comments on social feeds using on-device AI only.",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:ort && wxt",
    "build": "npm run copy:ort && wxt build",
    "zip": "npm run copy:ort && wxt zip",
    "postinstall": "node scripts/copy-ort-runtime.mjs && wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "copy:ort": "node scripts/copy-ort-runtime.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0"
  }
}
